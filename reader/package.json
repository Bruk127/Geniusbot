{
  "name": "readslow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Calm AI reading assistant — breath-sized phrases, slow speech, one-click repeat.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
